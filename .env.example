# ── Public (exposed to browser) ──
NEXT_PUBLIC_AI_URL=
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MCP_STELLAR_URL=
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_USDC_ISSUER=

# ── Server-only (internal service URLs) ──
BACKEND_INTERNAL_URL=
AI_INTERNAL_URL=

# ── API Keys ──
SOROSWAP_API_KEYS=
NEXT_PUBLIC_QUEST_API_URL=http://localhost:5555

# Quest social OAuth (server-side) — required for /api/auth/{discord,x,telegram}
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Public base URL used to build OAuth redirect URIs (e.g. https://app.tasmil-finance.xyz)
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Quest backend — server-side preferred over NEXT_PUBLIC_QUEST_BACKEND_URL (runtime-urls.ts)
QUEST_BACKEND_INTERNAL_URL=http://localhost:5555

# Waitlist gate — "true" requires access code on signup
NEXT_PUBLIC_WAITLIST_MODE=false
