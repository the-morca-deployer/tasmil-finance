{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "generate:api": "node scripts/kubb/fix-openapi.js && KUBB_TARGET=ai kubb --config kubb.config.ts && node scripts/kubb/fix-imports.js && node scripts/kubb/clean-temp.js",
    "generate:api:dev": "node scripts/kubb/fix-openapi.js && KUBB_TARGET=ai kubb --config kubb.config.ts && node scripts/kubb/fix-imports.js",
    "generate:backend": "node scripts/kubb/fix-openapi-nest.js --target=backend && KUBB_TARGET=backend kubb --config kubb.config.ts && node scripts/kubb/fix-imports.js --dir=src/gen-backend && node scripts/kubb/fix-nest-types.js --target=backend && node scripts/kubb/clean-temp.js",
    "generate:backend:dev": "node scripts/kubb/fix-openapi-nest.js --target=backend && KUBB_TARGET=backend kubb --config kubb.config.ts && node scripts/kubb/fix-imports.js --dir=src/gen-backend && node scripts/kubb/fix-nest-types.js --target=backend",
    "generate:all": "pnpm generate:api && pnpm generate:backend && pnpm generate:quest",
    "test:api": "node -e \"require('./src/lib/test-api.ts').testApiConnection().then(console.log)\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:chat": "playwright test --project=e2e-chat",
    "test:e2e:chat:smoke": "playwright test --project=e2e-chat e2e/smoke.spec.ts",
    "test:e2e:chat:mock": "playwright test --project=e2e-phase phase2-phase3 flows/phase-aware-flow.spec.ts",
    "test:e2e:chat:real": "playwright test --project=e2e-phase flows/deposit-intent-extraction.spec.ts flows/clarify-flow.spec.ts",
    "test:e2e:chat:phase": "playwright test --project=e2e-phase phase2-phase3",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "type-check": "tsc --noEmit",
    "prepare": "",
    "generate:quest": "node scripts/kubb/fix-openapi-nest.js --target=quest && KUBB_TARGET=quest kubb --config kubb.config.ts && node scripts/kubb/fix-imports.js --dir=src/gen-quest && node scripts/kubb/fix-nest-types.js --target=quest && node scripts/kubb/clean-temp.js"
  },
